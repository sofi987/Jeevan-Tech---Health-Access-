<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Health Access: Local Language Service Navigator</title>
<style>
:root{--blue:#005EB8;--dark:#003087;--light:#E8EDEE;--ink:#212B32;--mute:#4C6272;--line:#D8DDE0;--warn:#DA291C;--warn-l:#FCEBEA;--link:#005EB8;--white:#fff}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Arial,Helvetica,sans-serif;color:var(--ink);background:var(--white);line-height:1.6;font-size:18px}
a{color:var(--link)}
.skip{position:absolute;left:-999px}
.skip:focus{left:10px;top:10px;background:#fff;padding:8px;z-index:99}
/* utility bar */
.util{background:var(--dark);color:#fff;font-size:.9rem}
.util .in{max-width:1180px;margin:0 auto;padding:6px 20px;display:flex;justify-content:flex-end;gap:18px;flex-wrap:wrap}
.util a{color:#fff;text-decoration:none}
.util a:hover{text-decoration:underline}
/* header */
header.top{background:#fff;border-bottom:4px solid var(--blue)}
.top .in{max-width:1180px;margin:0 auto;padding:16px 20px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap}
.logo{display:flex;align-items:center;gap:12px;text-decoration:none;color:var(--dark)}
.logo .mark{width:46px;height:46px;background:var(--blue);color:#fff;border-radius:6px;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.4rem}
.logo strong{display:block;font-size:1.2rem;line-height:1.1}
.logo span{font-size:.85rem;color:var(--mute)}
.logo em.jt{font-style:normal;font-size:.8rem;font-weight:700;color:#fff;background:var(--blue);padding:2px 8px;border-radius:4px;margin-left:6px;vertical-align:middle}
.search{display:flex;border:2px solid var(--dark);border-radius:4px;overflow:hidden}
.search input{border:0;padding:9px 12px;font-size:1rem;width:240px;outline:none}
.search button{background:var(--dark);color:#fff;border:0;padding:0 16px;cursor:pointer;font-size:1rem}
/* nav */
nav.main{background:var(--blue)}
nav.main ul{list-style:none;margin:0 auto;padding:0;max-width:1180px;display:flex;flex-wrap:wrap}
nav.main a{display:block;color:#fff;text-decoration:none;padding:14px 16px;font-weight:700;font-size:.98rem}
nav.main a:hover,nav.main a:focus{background:var(--dark)}
/* hero */
.hero{position:relative;color:#fff;background:linear-gradient(90deg,rgba(0,48,135,.92),rgba(0,94,184,.75)),url("images/hero.jpg") center/cover no-repeat,var(--dark);padding:72px 20px}
.hero .in{max-width:1180px;margin:0 auto}
.hero h1{font-size:2.6rem;line-height:1.15;margin:0 0 14px;max-width:760px}
.hero p{font-size:1.2rem;max-width:680px;margin:0 0 22px}
.btn{display:inline-block;background:#fff;color:var(--dark);font-weight:700;padding:12px 22px;border-radius:4px;text-decoration:none}
/* quick tiles */
.tiles{max-width:1180px;margin:-44px auto 0;padding:0 20px;position:relative;display:grid;gap:16px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
.tile{background:#fff;border-top:6px solid var(--blue);box-shadow:0 2px 8px rgba(0,0,0,.12);padding:20px;text-decoration:none;color:var(--ink);display:block}
.tile:hover{box-shadow:0 4px 14px rgba(0,0,0,.2)}
.tile h3{margin:0 0 6px;color:var(--dark);font-size:1.15rem}
.tile p{margin:0;font-size:.95rem;color:var(--mute)}
/* sections */
section.wrap{max-width:1180px;margin:0 auto;padding:52px 20px}
section.grey{background:var(--light);max-width:none;padding:52px 20px}
section.grey>div{max-width:1180px;margin:0 auto}
h2{color:var(--dark);font-size:2rem;margin:0 0 14px}
h3{color:var(--dark)}
p{margin:0 0 14px}
.lead{font-size:1.2rem;color:var(--ink)}
.two{display:grid;gap:28px;grid-template-columns:1fr 1fr;align-items:center}
.photo{width:100%;height:320px;object-fit:cover;display:block;background:var(--light);border-radius:4px}
.box{background:#fff;padding:24px;border-left:6px solid var(--blue)}
.cards{display:grid;gap:20px;grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
.card{background:#fff;border:1px solid var(--line);display:flex;flex-direction:column}
.card img.img{display:block;width:100%;height:190px;object-fit:cover;background:linear-gradient(135deg,var(--blue),var(--dark))}
.card .body{padding:18px}
.card h3{margin:0 0 8px;font-size:1.2rem}
.card p{font-size:.98rem;color:var(--mute)}
.card a.more{font-weight:700}
/* navigator + phrases */
.panel{background:#fff;padding:24px;border:1px solid var(--line)}
label{display:block;font-weight:700;margin-bottom:6px}
select{width:100%;padding:12px;font-size:1rem;border:2px solid var(--dark);border-radius:4px;background:#fff;font-family:inherit}
.lang-bar{display:flex;flex-wrap:wrap;gap:8px;margin:0 0 16px}
.lang-bar button{border:2px solid var(--blue);background:#fff;color:var(--blue);padding:8px 14px;border-radius:4px;cursor:pointer;font-weight:700;font-size:.95rem}
.lang-bar button.on{background:var(--blue);color:#fff}
.phrase{display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;border-bottom:1px solid var(--line);padding:14px 0}
.phrase:last-child{border-bottom:0}
.native{font-size:1.25rem;font-weight:700;color:var(--ink)}
.roman{color:var(--mute);font-size:.95rem}
.speak{background:var(--blue);color:#fff;border:0;border-radius:4px;padding:8px 14px;cursor:pointer;font-weight:700}
.result{margin-top:16px;padding:20px;background:var(--light);border-left:6px solid var(--blue)}
.result.emergency{background:var(--warn-l);border-left-color:var(--warn)}
.result ul{margin:8px 0 0 20px;padding:0}
/* contacts */
.contacts{display:grid;gap:14px;grid-template-columns:repeat(auto-fit,minmax(240px,1fr))}
.contact{background:#fff;padding:20px;border-top:4px solid var(--dark)}
.contact .n{font-size:1.6rem;font-weight:700;color:var(--blue)}
.urgent{background:var(--warn);color:#fff;padding:18px 20px;margin-bottom:22px}
.urgent strong{font-size:1.2rem}
/* footer */
footer{background:var(--dark);color:#fff;margin-top:0}
footer .in{max-width:1180px;margin:0 auto;padding:40px 20px;display:grid;gap:28px;grid-template-columns:repeat(auto-fit,minmax(200px,1fr))}
footer h4{margin:0 0 10px;font-size:1rem}
footer ul{list-style:none;padding:0;margin:0}
footer li{margin-bottom:8px}
footer a{color:#fff;text-decoration:none;font-size:.95rem}
footer a:hover{text-decoration:underline}
.bottom{background:#00224f;color:#cfd8e3;font-size:.85rem;text-align:center;padding:14px 20px}
.textsize button{background:#fff;color:var(--dark);border:0;padding:3px 8px;margin-left:4px;cursor:pointer;font-weight:700;border-radius:3px}

/* backend request form */
.request-form{display:grid;gap:16px;grid-template-columns:1fr 1fr}
.request-form .full{grid-column:1/-1}
.request-form input,.request-form textarea{width:100%;padding:12px;font:inherit;border:2px solid var(--dark);border-radius:4px}
.request-form textarea{min-height:110px;resize:vertical}
.request-form button{background:var(--blue);color:#fff;border:0;border-radius:4px;padding:12px 18px;font:inherit;font-weight:700;cursor:pointer}
.request-form button:disabled{opacity:.65;cursor:wait}
#requestStatus{padding:12px;margin-top:14px;border-left:5px solid var(--blue);background:var(--light)}
#requestStatus[hidden]{display:none}
@media(max-width:600px){.request-form{grid-template-columns:1fr}.request-form .full{grid-column:auto}}

@media(max-width:820px){.two{grid-template-columns:1fr}.hero h1{font-size:2rem}.search input{width:150px}nav.main a{padding:12px 10px;font-size:.9rem}h2{font-size:1.6rem}}
</style>
</head>
<body>
<a class="skip" href="#main">Skip to main content</a>

<div class="util">
  <div class="in">
    <a href="#contacts">Contact us</a>
    <a href="#phrases">Phrase cards</a>
    <a href="#helplines">Emergency numbers</a>
    <span class="textsize">Text size:
      <button onclick="sizeText(-2)" aria-label="Decrease text size">A-</button><button onclick="sizeText(0)" aria-label="Reset text size">A</button><button onclick="sizeText(2)" aria-label="Increase text size">A+</button>
    </span>
  </div>
</div>

<header class="top" id="header">
  <div class="in">
    <a class="logo" href="#top"><div class="mark">HA</div><div><strong>Health Access Navigator <em class="jt">JeevanTECH</em></strong><span>Local language health service guide</span></div></a>
    <form class="search" onsubmit="return false"><input type="search" placeholder="Search services, e.g. fever" aria-label="Search"><button>Search</button></form>
  </div>
</header>

<nav class="main" id="nav" aria-label="Main">
  <ul>
    <li><a href="#navigator">Find a service</a></li>
     <li><a href="#request-help">Request help</a></li>
    <li><a href="#services">Our services</a></li>
    <li><a href="#phrases">Phrase cards</a></li>
    <li><a href="#helplines">Helplines</a></li>
    <li><a href="#problem">About the project</a></li>
    <li><a href="#contacts">Contact us</a></li>
  </ul>
</nav>

<main id="main">
<div class="hero" id="top">
  <div class="in">
    <h1>Health care in your own language</h1>
    <p>We help people who speak local languages find the right health service, know what to bring, and get help quickly in an emergency.</p>
    <a class="btn" href="#navigator">Find the right service</a>
  </div>
</div>

<div class="tiles">
  <a class="tile" href="#navigator"><h3>Find a service</h3><p>Choose your need and see where to go and what to bring.</p></a>
  <a class="tile" href="#phrases"><h3>Phrase cards</h3><p>Ready-to-use sentences in six languages, with audio.</p></a>
  <a class="tile" href="#helplines"><h3>Helplines</h3><p>National health and emergency numbers in one place.</p></a>
  <a class="tile" href="#problem"><h3>About the project</h3><p>Why language access matters in health care.</p></a>
</div>

<section class="wrap" id="problem">
  <div class="two">
    <div>
      <h2>Why language matters</h2>
      <p class="lead">Many patients are most comfortable in their mother tongue, but health forms, signs, and information are often in English or Hindi only.</p>
      <div class="box">
        <p><strong>Common barriers:</strong> not knowing where to go, unclear instructions, missing paperwork, and delayed emergency care.</p>
      </div>
    </div>
    <img class="photo" src="images/community-health-worker.jpg" alt="Community health worker visiting a patient" onerror="this.style.visibility='hidden'">
  </div>
</section>

<section class="grey" id="services">
  <div>
    <h2>Our services</h2>
    <p>This project offers four free tools for patients, families, and community health volunteers.</p>
    <div class="cards" style="margin-top:22px">
      <div class="card"><img class="img" src="images/service-1.jpg" alt="Patient and health worker using a phrase card" onerror="this.style.visibility='hidden'"><div class="body"><h3>Local phrase cards</h3><p>Sentences in Telugu, Hindi, Urdu, Tamil, Kannada, and English that can be shown or read aloud at a counter.</p><a class="more" href="#phrases">View phrase cards</a></div></div>
      <div class="card"><img class="img" src="images/service-2.jpg" alt="Clinic reception desk" onerror="this.style.visibility='hidden'"><div class="body"><h3>Service finder</h3><p>Pick your reason for visiting to see the right type of care and a checklist of documents to carry.</p><a class="more" href="#navigator">Find a service</a></div></div>
      <div class="card"><img class="img" src="images/service-3.jpg" alt="Ambulance and emergency staff" onerror="this.style.visibility='hidden'"><div class="body"><h3>Emergency first</h3><p>Warning signs and emergency numbers are always shown first, so urgent help is never missed.</p><a class="more" href="#helplines">Emergency numbers</a></div></div>
    </div>
  </div>
</section>

<section class="wrap" id="navigator">
  <h2>Find the right service</h2>
  <p>Select the main reason for your visit. This tool suggests where to go and what to bring. It does not diagnose.</p>
  <div class="panel">
    <label for="need">What do you need help with?</label>
    <select id="need">
      <option value="">-- Choose an option --</option>
      <option value="emergency">Severe chest pain, trouble breathing, heavy bleeding, or unconsciousness</option>
      <option value="fever">Fever, cough, or cold lasting several days</option>
      <option value="pregnancy">Pregnancy check-up or delivery</option>
      <option value="child">Child vaccination or child health</option>
      <option value="chronic">Ongoing care (e.g., diabetes or blood pressure)</option>
      <option value="eye">Eye or dental problem</option>
      <option value="scheme">Using a government health scheme card</option>
    </select>
    <div id="result"></div>
  </div>
</section>


<section class="wrap" id="request-help">
  <h2>Request help from our team</h2>
  <p>Send a service request to the JeevanTECH team. Please do not include medical records, passwords, or other sensitive health information.</p>
  <div class="panel">
    <form id="serviceRequestForm" class="request-form">
      <div>
        <label for="requestName">Your name</label>
        <input id="requestName" name="name" type="text" maxlength="100" autocomplete="name" required>
      </div>
      <div>
        <label for="requestContact">Phone number or email</label>
        <input id="requestContact" name="contact" type="text" maxlength="150" autocomplete="email" required>
      </div>
      <div>
        <label for="contactMethod">Preferred contact method</label>
        <select id="contactMethod" name="contact_method" required>
          <option value="">-- Choose a method --</option>
          <option value="text">Text message</option>
          <option value="email">Email</option>
          <option value="phone">Phone call</option>
        </select>
      </div>
      <div>
        <label for="requestNeed">What do you need?</label>
        <select id="requestNeed" name="need" required>
          <option value="">-- Choose a need --</option>
          <option value="booking">Help with a booking</option>
          <option value="find-service">Help finding a health service</option>
          <option value="other">Other question</option>
        </select>
      </div>
      <div class="full">
        <label for="requestMessage">Message (optional)</label>
        <textarea id="requestMessage" name="message" maxlength="1000" placeholder="Briefly describe what help you need."></textarea>
      </div>
      <div class="full">
        <button id="requestSubmit" type="submit">Send request</button>
        <p id="requestStatus" role="status" aria-live="polite" hidden></p>
      </div>
    </form>
  </div>
</section>

<section class="grey" id="phrases">
  <div>
    <h2>Phrase cards</h2>
    <p>Pick a language and press “Listen” to hear the phrase. Audio works if your device has that language voice installed.</p>
    <div class="panel" style="margin-top:18px">
      <div class="lang-bar" id="langBar"></div>
      <div id="phraseList"></div>
    </div>
    <p style="font-size:.9rem;color:var(--mute);margin-top:12px">These phrases are starting points. For medical advice, speak to a qualified health worker or interpreter.</p>
  </div>
</section>

<section class="wrap" id="helplines">
  <h2>Helplines and emergency numbers</h2>
  <div class="urgent"><strong>Emergency?</strong> Call <strong>112</strong> or <strong>108</strong> now. Do not wait.</div>
  <div class="contacts">
    <div class="contact"><div class="n">112</div><h3>Emergency (all services)</h3><p>Police, fire, and ambulance.</p></div>
    <div class="contact"><div class="n">108</div><h3>Ambulance</h3><p>Free emergency transport in most states.</p></div>
    <div class="contact"><div class="n">104</div><h3>National health helpline</h3><p>General health information and guidance.</p></div>
    <div class="contact"><div class="n">14555</div><h3>Ayushman Bharat (PM-JAY)</h3><p>Questions about health insurance coverage.</p></div>
    <div class="contact"><div class="n">102</div><h3>Mother and child helpline</h3><p>Pregnancy and child health support.</p></div>
  </div>
  <p style="font-size:.9rem;color:var(--mute);margin-top:14px">Confirm current availability on official government websites.</p>
</section>
</main>

<footer id="contacts">
  <div class="in">
    <div>
      <h4>Contact us</h4>
      <ul>
        <li>General queries: <a href="tel:104">104</a></li>
        <li>Emergency: <a href="tel:112">112</a></li>
        <li>Ambulance: <a href="tel:108">108</a></li>
      </ul>
    </div>
    <div>
      <h4>Explore</h4>
      <ul>
        <li><a href="#navigator">Find a service</a></li>
        <li><a href="#services">Our services</a></li>
        <li><a href="#phrases">Phrase cards</a></li>
        <li><a href="#helplines">Helplines</a></li>
      </ul>
    </div>
    <div>
      <h4>Useful information</h4>
      <ul>
        <li><a href="#problem">About the project</a></li>
        <li><a href="#top">Back to top</a></li>
      </ul>
    </div>
  </div>
  <div class="bottom">Health Access: Local Language Service Navigator · College project · Information for education only. Not a substitute for professional medical care.</div>
</footer>

<script>
function sizeText(step){
  const root=document.body;
  if(step===0){root.style.fontSize='';return;}
  const current=parseFloat(getComputedStyle(root).fontSize);
  root.style.fontSize=(current+step)+'px';
}

const phrases = {
  "English": [["I need a doctor","I need a doctor"],["Where is the hospital?","Where is the hospital?"],["This is an emergency","This is an emergency"],["I need help in my language","I need help in my language"]],
  "Telugu": [["నాకు డాక్టర్ కావాలి","Naaku doctor kaavaali"],["ఆసుపత్రి ఎక్కడ ఉంది?","Aasupatri ekkada undi?"],["ఇది అత్యవసరం","Idi atyavasaram"],["నాకు నా భాషలో సహాయం కావాలి","Naaku naa bhashalo sahayam kaavaali"]],
  "Hindi": [["मुझे डॉक्टर चाहिए","Mujhe doctor chahiye"],["अस्पताल कहाँ है?","Aspataal kahaan hai?"],["यह आपातकाल है","Yah aapatkaal hai"],["मुझे अपनी भाषा में मदद चाहिए","Mujhe apni bhasha mein madad chahiye"]],
  "Urdu": [["مجھے ڈاکٹر چاہیے","Mujhe doctor chahiye"],["ہسپتال کہاں ہے؟","Hospital kahan hai?"],["یہ ایمرجنسی ہے","Yeh emergency hai"],["مجھے اپنی زبان میں مدد چاہیے","Mujhe apni zaban mein madad chahiye"]],
  "Tamil": [["எனக்கு டாக்டர் வேண்டும்","Enakku doctor vendum"],["மருத்துவமனை எங்கே?","Maruthuvamanai enge?"],["இது அவசரநிலை","Idhu avasaranilai"],["எனக்கு என் மொழியில் உதவி வேண்டும்","Enakku en mozhiyil udhavi vendum"]],
  "Kannada": [["ನನಗೆ ವೈದ್ಯರು ಬೇಕು","Nanage vaidyaru beku"],["ಆಸ್ಪತ್ರೆ ಎಲ್ಲಿದೆ?","Aspatre ellide?"],["ಇದು ತುರ್ತು","Idu turthu"],["ನನಗೆ ನನ್ನ ಭಾಷೆಯಲ್ಲಿ ಸಹಾಯ ಬೇಕು","Nanage nanna bhashe yalli sahaaya beku"]]
};
const speechCodes={English:"en-IN",Telugu:"te-IN",Hindi:"hi-IN",Urdu:"ur-PK",Tamil:"ta-IN",Kannada:"kn-IN"};
const langBar=document.getElementById("langBar");
const phraseList=document.getElementById("phraseList");

function speak(text,lang){
  if(!("speechSynthesis" in window))return;
  const u=new SpeechSynthesisUtterance(text);u.lang=lang;
  speechSynthesis.cancel();speechSynthesis.speak(u);
}
function showLang(name){
  [...langBar.children].forEach(b=>b.classList.toggle("on",b.textContent===name));
  phraseList.innerHTML="";
  phrases[name].forEach(([native,roman])=>{
    const row=document.createElement("div");row.className="phrase";
    const left=document.createElement("div");
    const n=document.createElement("div");n.className="native";n.textContent=native;
    const r=document.createElement("div");r.className="roman";r.textContent=roman;
    left.append(n,r);
    const btn=document.createElement("button");btn.className="speak";btn.textContent="Listen";
    btn.onclick=()=>speak(native,speechCodes[name]);
    row.append(left,btn);phraseList.append(row);
  });
}
Object.keys(phrases).forEach(name=>{
  const b=document.createElement("button");b.textContent=name;b.onclick=()=>showLang(name);langBar.append(b);
});
showLang("Telugu");

/*
  IMPORTANT: Replace this with your deployed Flask backend base URL.
  Example format: https://your-backend-service.example.com
  Do not include /api/requests at the end.
*/
const API_BASE = "https://YOUR-BACKEND-URL";

const serviceRequestForm = document.getElementById("serviceRequestForm");
if (serviceRequestForm) {
  serviceRequestForm.addEventListener("submit", async (event) => {
    event.preventDefault();

    const status = document.getElementById("requestStatus");
    const submitButton = document.getElementById("requestSubmit");
    const formData = new FormData(serviceRequestForm);
    const payload = {
      name: String(formData.get("name") || "").trim(),
      contact: String(formData.get("contact") || "").trim(),
      contact_method: String(formData.get("contact_method") || ""),
      need: String(formData.get("need") || ""),
      message: String(formData.get("message") || "").trim()
    };

    status.hidden = false;
    status.textContent = "";
    if (API_BASE.includes("YOUR-BACKEND-URL")) {
      status.textContent = "The website form is ready, but the backend URL has not been configured yet. Update API_BASE in index.html after deploying app.py.";
      return;
    }

    submitButton.disabled = true;
    submitButton.textContent = "Sending…";
    try {
      const response = await fetch(`${API_BASE.replace(/\/+$/, "")}/api/requests`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload)
      });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) {
        throw new Error(result.error || "Could not submit your request. Please try again.");
      }
      status.textContent = result.message || "Thank you. Your request was submitted.";
      serviceRequestForm.reset();
    } catch (error) {
      status.textContent = error.message || "Unable to reach the service right now. Please try again later.";
    } finally {
      submitButton.disabled = false;
      submitButton.textContent = "Send request";
    }
  });
}

</script>
</body>
</html>
